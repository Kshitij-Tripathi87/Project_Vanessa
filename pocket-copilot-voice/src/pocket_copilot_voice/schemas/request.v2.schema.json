{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocket-copilot.local/schemas/request.v2.schema.json",
  "title": "Pocket Co-pilot Voice Interpretation Input v2",
  "description": "Input to the on-device controller model. Includes transcript, device context, capability shortlist, and conversation context.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "transcript",
    "locale",
    "asr_confidence",
    "network_state",
    "capability_manifest",
    "conversation_context"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this request, generated by the phone app."
    },
    "transcript": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "ASR transcript of the user's utterance."
    },
    "locale": {
      "type": "string",
      "enum": ["en-IN", "hi-IN", "hinglish", "en"],
      "description": "Language locale of the transcript."
    },
    "asr_confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "ASR confidence score for the transcript."
    },
    "network_state": {
      "type": "string",
      "enum": ["online", "offline"],
      "description": "Whether the phone has network connectivity to the laptop."
    },
    "device_session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_id", "laptop_id", "session_id", "manifest_version"],
      "properties": {
        "device_id": {
          "type": "string",
          "description": "Paired phone device identity."
        },
        "laptop_id": {
          "type": "string",
          "description": "Paired laptop device identity."
        },
        "session_id": {
          "type": "string",
          "description": "Active laptop session identifier."
        },
        "manifest_version": {
          "type": "integer",
          "minimum": 1,
          "description": "Version of the capability manifest this request is bound to."
        }
      }
    },
    "capability_manifest": {
      "type": "array",
      "maxItems": 12,
      "description": "Shortlist of relevant capabilities supplied by the laptop for this request.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability_id", "version", "display_name", "description", "input_schema", "risk", "approval"],
        "properties": {
          "capability_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_*]*)+$",
            "description": "Stable namespaced capability identifier (e.g., filesystem.search, project.run_tests)."
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "Semantic version of this capability."
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Human-readable name for UI display."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Brief description of what this capability does."
          },
          "input_schema": {
            "type": "object",
            "description": "JSON Schema for the capability's input arguments. additionalProperties must be false unless explicitly justified."
          },
          "output_schema": {
            "type": "object",
            "description": "JSON Schema for the capability's output (for model awareness)."
          },
          "required_scopes": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Scopes required to invoke this capability."
          },
          "risk": {
            "type": "string",
            "enum": ["read_only", "low_impact", "modification", "sensitive", "high_impact"],
            "description": "Risk classification for policy enforcement."
          },
          "approval": {
            "type": "string",
            "enum": ["none", "preview", "explicit", "strong"],
            "description": "Approval requirement level."
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 1800000,
            "default": 30000,
            "description": "Maximum execution time in milliseconds."
          },
          "supports_preview": {
            "type": "boolean",
            "default": false,
            "description": "Whether the capability supports a dry-run preview."
          },
          "supports_cancel": {
            "type": "boolean",
            "default": false,
            "description": "Whether the capability supports cooperative cancellation."
          },
          "health": {
            "type": "string",
            "enum": ["ready", "degraded", "unavailable"],
            "default": "ready",
            "description": "Current health state of the capability adapter."
          }
        }
      }
    },
    "conversation_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previous_request_id": {
          "type": "string",
          "format": "uuid"
        },
        "previous_decision": {
          "type": "string",
          "enum": ["invoke_capability", "delegate_task", "clarify", "refuse", "no_action"]
        },
        "entities": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "value"],
            "properties": {
              "type": { "type": "string" },
              "value": { "type": "string" },
              "resolved": { "type": "boolean", "default": false }
            }
          },
          "description": "Recently referenced entities for contextual follow-ups."
        },
        "active_task": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "task_id": { "type": "string" },
                "description": { "type": "string" }
              }
            },
            { "type": "null" }
          ],
          "description": "Currently running multi-step task if any."
        }
      }
    }
  }
}