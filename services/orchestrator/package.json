{
  "name": "@vanessa/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "smoke:codex": "tsx src/scripts/codex-smoke.ts",
    "test:codex": "tsx --test src/tests/codexLauncher.test.ts",
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test:scenarios": "tsx src/tests/scenarios.test.ts",
    "test:skills": "tsx src/tests/skillsRuntime.test.ts",
    "test:voice-planning": "tsx src/tests/voicePlanning.test.ts",
    "test:playwright": "tsx src/tests/playwright.test.ts",
    "test:agent-routing": "tsx --test src/tests/agentRouting.test.ts src/tests/folderAgent.test.ts src/tests/fileAgent.test.ts src/tests/browserAgent.unit.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/websocket": "^11.0.2",
    "@vanessa/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ws": "^8.18.0",
    "playwright": "^1.40.0",
    "playwright-core": "^1.40.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^22.13.4",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
