{
  "name": "@vanessa/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/index.js",
  "build": {
    "appId": "com.vanessa.desktop",
    "productName": "Vanessa",
    "icon": "assets/vanessa.png",
    "files": [
      "dist/**/*",
      "assets/**/*"
    ]
  },
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vanessa/protocol": "workspace:*",
    "@vanessa/shared": "workspace:*",
    "better-sqlite3": "^11.8.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.15.2",
    "ws": "^8.18.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/sql.js": "^1.4.11",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  }
}