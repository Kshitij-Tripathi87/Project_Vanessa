{
  "name": "@vanessa/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/index.js",
  "description": "Vanessa - Voice-native AI control layer",
  "author": "Vanessa Labs",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc && tsc -p tsconfig.node.json && vite build",
    "build:installer": "electron-builder --win nsis",
    "preview": "vite preview",
    "test:docking": "node --test dist/main/docking.test.js"
  },
  "dependencies": {
    "@vanessa/shared": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "electron-builder": "^24.13.3",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "productName": "Vanessa",
    "appId": "com.vanessa.app",
    "directories": {
      "output": "dist/installers",
      "buildResources": "assets"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false,
      "forceCodeSigning": false
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json",
      "assets/**/*"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false
    },
    "extraResources": [
      {
        "from": "runtime/orchestrator",
        "to": "runtime/orchestrator",
        "filter": [
          "**/*",
          "**/.pnpm/**"
        ]
      },
      {
        "from": "runtime/voice-agent",
        "to": "runtime/voice-agent",
        "filter": [
          "**/*",
          "**/.pnpm/**"
        ]
      },
      {
        "from": "runtime/skills",
        "to": "runtime/skills"
      },
      {
        "from": "runtime/config",
        "to": "runtime/config"
      },
      {
        "from": "runtime/build-meta.json",
        "to": "runtime/build-meta.json"
      },
      {
        "from": "runtime/node.exe",
        "to": "runtime/node.exe"
      },
      {
        "from": "assets/vanessa-tray.png",
        "to": "vanessa-tray.png"
      },
      {
        "from": "runtime/vanessa.env.example",
        "to": "vanessa.env.example"
      }
    ]
  }
}
