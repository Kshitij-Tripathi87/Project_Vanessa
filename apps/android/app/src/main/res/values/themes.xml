<resources>
    <style name="Theme.Vanessa" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/vanessa_primary</item>
        <item name="colorPrimaryVariant">@color/vanessa_primary_variant</item>
        <item name="colorOnPrimary">@color/vanessa_on_primary</item>
        <item name="colorSecondary">@color/vanessa_secondary</item>
        <item name="colorSecondaryVariant">@color/vanessa_secondary_variant</item>
        <item name="colorOnSecondary">@color/vanessa_on_secondary</item>
        <item name="colorError">@color/vanessa_error</item>
        <item name="colorOnError">@color/vanessa_on_error</item>
        <item name="android:colorBackground">@color/vanessa_background</item>
        <item name="colorSurface">@color/vanessa_surface</item>
        <item name="colorSurfaceVariant">@color/vanessa_surface_variant</item>
        <item name="colorOnSurface">@color/vanessa_on_surface</item>
        <item name="colorOutline">@color/vanessa_outline</item>
        <item name="android:windowBackground">@color/vanessa_background</item>
        <item name="android:statusBarColor">@color/vanessa_background</item>
        <item name="android:navigationBarColor">@color/vanessa_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.Vanessa.Fullscreen" parent="Theme.Vanessa">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
