{
  "name": "vanessa-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Vanessa: Voice-native AI control layer for personal computers",
  "scripts": {
    "dev": "concurrently -n \"ORCHESTRATOR,VOICE,RELAY,DESKTOP\" -c \"cyan,yellow,blue,magenta\" --kill-others-on-fail \"pnpm --filter @vanessa/orchestrator dev\" \"pnpm --filter @vanessa/voice-agent dev\" \"pnpm --filter @vanessa/relay dev\" \"pnpm --filter @vanessa/desktop dev\"",
    "dev:relay": "pnpm --filter @vanessa/relay dev",
    "dev:orchestrator": "pnpm --filter @vanessa/orchestrator dev",
    "dev:voice": "pnpm --filter @vanessa/voice-agent dev",
    "dev:desktop": "pnpm --filter @vanessa/desktop dev",
    "readiness": "pnpm --filter @vanessa/orchestrator exec tsx ../../scripts/check_readiness.ts",
    "build": "pnpm -r run build",
    "test:scenarios": "pnpm --filter @vanessa/orchestrator test:scenarios",
    "test:skills": "pnpm --filter @vanessa/orchestrator test:skills",
    "test:voice:planning": "pnpm --filter @vanessa/orchestrator test:voice-planning",
    "test:browser-agent": "pnpm --filter @vanessa/orchestrator test:browser-agent",
    "test:windows-agent": "pnpm --filter @vanessa/orchestrator test:windows-agent",
    "test:compound-voice-plan": "pnpm --filter @vanessa/orchestrator test:compound-voice-plan",
    "test:drills": "pnpm --filter @vanessa/orchestrator exec tsx ../../evals/drills/failureDrills.test.ts",
    "test:drills:process": "pnpm --filter @vanessa/orchestrator exec tsx ../../evals/drills/processFailureDrills.test.ts",
    "test:checkout:gate": "pnpm --filter @vanessa/orchestrator exec tsx src/tests/checkoutIncidentGate.test.ts",
    "test:voice:real": ".venv-voice\\Scripts\\python.exe scripts/test_real_voice_pipeline.py test_wifi.wav",
    "test:voice:behavior": "pnpm --filter @vanessa/voice-agent test:behavior",
    "test:voice:fish:acceptance": "RUN_REAL_PROVIDER_TESTS=1 pnpm --filter @vanessa/voice-agent test:fish:acceptance",
    "test:all": "pnpm test:scenarios && pnpm test:skills && pnpm test:drills && pnpm test:drills:process && pnpm --filter @vanessa/voice-agent test && pnpm --filter @vanessa/voice-agent test:behavior",
    "lint": "pnpm -r run lint"
  },
  "devDependencies": {
    "@types/dotenv": "^8.2.3",
    "@types/node": "^22.10.1",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.2",
    "dotenv": "^16.6.1",
    "pdf-parse": "^2.4.5",
    "typescript": "^5.7.3",
    "ws": "^8.22.0"
  },
  "packageManager": "pnpm@11.24.0"
}
