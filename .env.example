# App Configuration
VANESSA_PORT=4319
VANESSA_ENV=development

# Voice Provider: sarvam | fish | voice | whisper | elevenlabs
VOICE_ASR_PROVIDER=sarvam
VOICE_TTS_PROVIDER=sarvam
VOICE_ALLOW_FALLBACK=false
VOICE_TTS_FALLBACK_PROVIDER=none
VOICE_URL=ws://127.0.0.1:4505
VOICE_MODEL=tiny.en
VOICE_AGENT_PORT=4500

# Sarvam STT (replace placeholders before enabling)
# Development/BYOK only: local keys are not a secure shared-key distribution.
# Never package .env or set VITE_* provider secrets. Hosted shared credentials
# require an authenticated backend (not included in this desktop prototype).
# Signup credits are limited; check your Sarvam dashboard balance.
SARVAM_API_KEY=
SARVAM_ASR_MODEL=saaras:v3-realtime
SARVAM_ASR_LANGUAGE=auto
# Optional v4 keyterm prompting, comma-separated. Use saaras:v4 to enable it.
SARVAM_ASR_KEYTERMS=
SARVAM_ASR_URL=wss://api.sarvam.ai/speech-to-text-realtime/ws
SARVAM_ASR_MAX_RECONNECT_ATTEMPTS=2
SARVAM_ASR_RECONNECT_BASE_DELAY_MS=250
SARVAM_ASR_CONNECTION_TIMEOUT_MS=10000
SARVAM_ASR_FINALIZATION_TIMEOUT_MS=10000

# Sarvam Bulbul streaming TTS (replace placeholders before enabling)
SARVAM_TTS_URL=wss://api.sarvam.ai/text-to-speech/ws
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=shubh_enhi_ads
SARVAM_TTS_LANGUAGE=en-IN
SARVAM_TTS_OUTPUT_CODEC=mp3
SARVAM_TTS_BITRATE=128k
SARVAM_TTS_SAMPLE_RATE=24000
SARVAM_TTS_MIN_BUFFER_SIZE=20
SARVAM_TTS_MAX_CHUNK_LENGTH=200
SARVAM_TTS_TIMEOUT_MS=30000

# Local Whisper ASR (fallback)
VOICE_VAD_THRESHOLD=120
VOICE_VAD_CALIBRATE_MS=500
VOICE_TURN_SILENCE_MS=650
VOICE_TURN_MIN_SPEECH_MS=350

# Wake Word Provider
VOICE_WAKE_PROVIDER=transcript
PORCUPINE_ACCESS_KEY=
PORCUPINE_KEYWORDS=hey vanessa,vanessa
PORCUPINE_SENSITIVITY=0.5
PORCUPINE_MODEL_PATH=

# Fish Audio Realtime Pipeline
FISH_API_KEY=
FISH_ASR_MODEL=transcribe-stream-1
FISH_TTS_MODEL=s2.1-pro-free
FISH_TTS_VOICE_ID=
FISH_TTS_SAMPLE_RATE=24000
FISH_TTS_TIMEOUT_MS=30000
# Backward-compatible alias; prefer FISH_TTS_VOICE_ID.
FISH_VANESSA_VOICE_ID=

# Circuit Breaker / Reconnection
VOICE_MAX_RECONNECT_ATTEMPTS=5

# Strict Config Mode (exit on config errors)
VOICE_STRICT_CONFIG=false

# ElevenLabs Conversational AI
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=

# Planner & Multi-LLM Routing
PLANNER_PROVIDER=sarvam
SARVAM_CHAT_PROVIDER=sarvam
SARVAM_CHAT_URL=https://api.sarvam.ai/v1/chat/completions
SARVAM_CHAT_MODEL=sarvam-105b-conversations
SARVAM_CHAT_TIMEOUT_MS=30000
SARVAM_CHAT_MAX_OUTPUT_TOKENS=512
SARVAM_CHAT_PLANNER_MAX_OUTPUT_TOKENS=4096
SARVAM_CHAT_CONVERSATION_MAX_OUTPUT_TOKENS=256
SARVAM_CHAT_INR_PER_1K_INPUT_TOKENS=0.015
SARVAM_CHAT_INR_PER_1K_OUTPUT_TOKENS=0.06
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
NVIDIA_API_KEY=nvapi-placeholder-key-replace-with-your-nvidia-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
PLANNER_API_KEY=
PLANNER_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# In-process estimated-spend caps; reset on restart. Voice (ASR+TTS) and chat
# have separate ledgers, NOT one durable account-wide quota. 0 means meter only.
# Positive caps require positive rates for selected providers. Rates are user
# supplied estimates; provider usage is labeled separately, not an invoice.
# Rates below are indicative; confirm current billing in the Sarvam dashboard.
VOICE_BUDGET_CAP_INR=0
VOICE_BUDGET_PER_USER_CAP_INR=0
SARVAM_ASR_INR_PER_AUDIO_SECOND=0.0081667
SARVAM_TTS_INR_PER_1K_CHARACTERS=1.0

# Browser Automation (Playwright)
PLAYWRIGHT_HEADLESS=false

# Cloud & Google Drive Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4319/auth/google/callback
