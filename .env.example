# App Configuration
VANESSA_PORT=4319
VANESSA_ENV=development

# Voice Provider: fish (default) | sarvam | voice | whisper | elevenlabs
VOICE_ASR_PROVIDER=Sarvam
VOICE_TTS_PROVIDER=fish
VOICE_ALLOW_FALLBACK=false
VOICE_TTS_FALLBACK_PROVIDER=none
VOICE_URL=ws://127.0.0.1:4505
VOICE_MODEL=tiny.en
VOICE_AGENT_PORT=4500

# Sarvam STT (set VOICE_ASR_PROVIDER=sarvam to enable; TTS is independent)
# Signup credits are limited; check your Sarvam dashboard balance.
SARVAM_API_KEY=
SARVAM_ASR_MODEL=saaras:v3-realtime
SARVAM_ASR_LANGUAGE=auto

# ElevenLabs Conversational AI
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=

# Fish Audio Realtime Pipeline
FISH_API_KEY=
FISH_ASR_MODEL=transcribe-stream-1
FISH_TTS_MODEL=s2.1-pro-free
FISH_TTS_VOICE_ID=
FISH_TTS_SAMPLE_RATE=24000
# Backward-compatible alias; prefer FISH_TTS_VOICE_ID.
FISH_VANESSA_VOICE_ID=

# Planner & Multi-LLM Routing
PLANNER_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-placeholder-key-replace-with-your-nvidia-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
PLANNER_API_KEY=
PLANNER_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Browser Automation (Playwright)
PLAYWRIGHT_HEADLESS=false

# Cloud & Google Drive Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4319/auth/google/callback
