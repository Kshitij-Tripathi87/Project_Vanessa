# App Configuration
VANESSA_PORT=4139
VANESSA_ENV=development

# Voice Provider: sarvam | fish (default) | elevenlabs | voice (local Whisper)
VOICE_ASR_PROVIDER=sarvam
VOICE_TTS_PROVIDER=fish
VOICE_ALLOW_FALLBACK=false
VOICE_TTS_FALLBACK_PROVIDER=none
VOICE_AGENT_PORT=4500
VOICE_COMMAND_SOURCE=desktop

# Sarvam STT (set VOICE_ASR_PROVIDER=sarvam to enable; TTS is independent)
SARVAM_API_KEY=
SARVAM_ASR_MODEL=saaras:v3-realtime
SARVAM_ASR_LANGUAGE=auto

# Local Whisper ASR (fallback)
VOICE_URL=ws://127.0.0.1:4505
VOICE_MODEL=tiny.en

# VAD / Turn Detection Tuning
VOICE_VAD_THRESHOLD=120              # Energy threshold for VAD (default 120)
VOICE_VAD_CALIBRATE_MS=500           # Calibration duration in ms (default 500ms)
VOICE_TURN_SILENCE_MS=650            # Silence threshold for turn completion (default 650ms)
VOICE_TURN_MIN_SPEECH_MS=350         # Minimum speech duration before turn can complete (default 350ms)

# Local Wake Word (Porcupine; inference runs locally on this device)
# Create/download a Windows-compatible custom "Hey Vanessa" .ppn model in Picovoice Console.
# Until these values are configured, click-to-chat and push-to-talk remain available but the wake word is reported as unavailable.
VOICE_WAKE_PROVIDER=porcupine      # porcupine | transcript
VOICE_WAKE_PHRASE=Hey Vanessa
PORCUPINE_ACCESS_KEY=
PORCUPINE_KEYWORD_PATHS="C:/path/to/hey-vanessa_windows.ppn"  # One or more comma-separated .ppn paths
PORCUPINE_SENSITIVITY=0.55
PORCUPINE_MODEL_PATH=             # Optional language model (.pv); not the keyword .ppn file

# Fish Audio Realtime Pipeline
FISH_API_KEY=
FISH_ASR_MODEL=transcribe-stream-1
FISH_TTS_MODEL=s2.1-pro-free
FISH_TTS_VOICE_ID=
FISH_TTS_SAMPLE_RATE=24000
FISH_TTS_TIMEOUT_MS=30000
# Backward-compatible alias; prefer FISH_TTS_VOICE_ID.
FISH_VANESSA_VOICE_ID=

# Circuit Breaker / Reconnection
VOICE_MAX_RECONNECT_ATTEMPTS=5       # Max Fish ASR reconnect attempts before fallback

# Strict Config Mode (exit on config errors)
VOICE_STRICT_CONFIG=false

# ElevenLabs Conversational AI
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=

# Planner & Multi-LLM Routing
PLANNER_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
PLANNER_API_KEY=
PLANNER_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# Browser Automation (Playwright)
BROWSER_HEADLESS=true

# Cloud & Google Drive Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4139/auth/google/callback
