# App Configuration
VANESSA_PORT=4139
VANESSA_ENV=development

# Voice Provider Configuration
VOICE_ASR_PROVIDER=fish          # fish | elevenlabs | voice (local Whisper)
VOICE_TTS_PROVIDER=fish          # fish | elevenlabs
VOICE_ALLOW_FALLBACK=false       # true = enable local Whisper / browser fallback
VOICE_TTS_FALLBACK_PROVIDER=none # browser = enable browser SpeechSynthesis fallback
VOICE_AGENT_PORT=4500

# Local Whisper ASR (fallback)
VOICE_URL=ws://127.0.0.1:4505
VOICE_MODEL=tiny.en

# VAD / Turn Detection Tuning
VOICE_VAD_THRESHOLD=120              # Energy threshold for VAD (default 120)
VOICE_VAD_CALIBRATE_MS=500           # Calibration duration in ms (default 500ms)
VOICE_TURN_SILENCE_MS=650            # Silence threshold for turn completion (default 650ms)
VOICE_TURN_MIN_SPEECH_MS=350         # Minimum speech duration before turn can complete (default 350ms)

# Wake Word Provider
VOICE_WAKE_PROVIDER=transcript       # transcript | porcupine
# Porcupine (optional audio-level wake word)
PORCUPINE_ACCESS_KEY=
PORCUPINE_KEYWORDS=hey vanessa,vanessa
PORCUPINE_SENSITIVITY=0.5
PORCUPINE_MODEL_PATH=

# Fish Audio Realtime Pipeline
FISH_API_KEY=
FISH_ASR_MODEL=transcribe-stream-1
FISH_TTS_MODEL=s2.1-pro-free
FISH_TTS_VOICE_ID=
FISH_TTS_SAMPLE_RATE=24000
FISH_TTS_TIMEOUT_MS=30000
# Backward-compatible alias; prefer FISH_TTS_VOICE_ID.
FISH_VANESSA_VOICE_ID=

# Circuit Breaker / Reconnection
VOICE_MAX_RECONNECT_ATTEMPTS=5       # Max Fish ASR reconnect attempts before fallback

# Strict Config Mode (exit on config errors)
VOICE_STRICT_CONFIG=false

# ElevenLabs Conversational AI
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=

# Planner & Multi-LLM Routing
PLANNER_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-placeholder-key-replace-with-your-nvidia-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
PLANNER_API_KEY=
PLANNER_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# Browser Automation (Playwright)
PLAYWRIGHT_HEADLESS=false

# Cloud & Google Drive Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4319/auth/google/callback
