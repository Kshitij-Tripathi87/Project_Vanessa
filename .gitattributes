# Windows batch files stay CRLF.
*.bat text eol=crlf

# The Gradle wrapper script runs on Linux CI; a CRLF checkout breaks its shebang.
apps/android/gradlew text eol=lf

# Binary generated artifacts
*.jar binary
*.png binary
*.pptx binary

# Shared protocol artifacts are diffed by CI; keep them LF everywhere.
packages/shared/schema/*.json text eol=lf
packages/shared/fixtures/*.jsonl text eol=lf
packages/protocol/schema/*.json text eol=lf
